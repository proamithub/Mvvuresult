@model StudentMasterDTO
@{
    ViewBag.Title = "Student Admitted";
}

<style>
    @@media only screen and (max-width: 600px) {
        body {
            min-width: 30cm;
        }
    }

    @@media print {
        @@page {
            size: portrait;
            margin: 4mm 5mm;
        }

        * {
            box-sizing: border-box !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .login-header, #footer, footer, .btn, .no-print, .hidden-print {
            display: none !important;
        }

        html, body {
            background: #fff !important;
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
            min-width: 0 !important;
            max-width: 100% !important;
            overflow: visible !important;
        }

        #wrap, .container, .row, #Cpytxt {
            max-width: 100% !important;
            width: 100% !important;
            min-width: 0 !important;
            padding: 0 !important;
            margin: 0 !important;
            border: none !important;
        }

        .page {
            margin: 0 !important;
            box-shadow: none !important;
            border: none !important;
            padding: 0 !important;
            width: 100% !important;
            max-width: 100% !important;
            min-width: 0 !important;
            min-height: auto !important;
            height: auto !important;
            background: #fff !important;
        }

        .subpage {
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
            max-width: 100% !important;
            min-width: 0 !important;
        }

        #prnttb {
            width: 100% !important;
            max-width: 100% !important;
            min-width: 0 !important;
            box-sizing: border-box !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .table {
            width: 100% !important;
            border-collapse: collapse !important;
            margin-bottom: 0 !important;
        }

        .table td, .table th {
            padding: 2.5px 3px !important;
            border-top: none !important;
        }

        /* Ensure outer table has crisp 1px borders all around */
        #prnttb > div > table,
        #prnttb > table {
            width: 100% !important;
            border: 1px solid #000 !important;
            border-collapse: collapse !important;
        }

        /* Ensure all direct outer cells have left and right borders */
        #prnttb > div > table > tbody > tr > td,
        #prnttb > div > table > tr > td,
        #prnttb > table > tbody > tr > td,
        #prnttb > table > tr > td {
            border-left: 1px solid #000 !important;
            border-right: 1px solid #000 !important;
        }

        /* Ensure right-most border is never cut off */
        #prnttb table tr th:last-child,
        #prnttb table tr td:last-child {
            border-right: 1px solid #000 !important;
        }

        .watermark {
            top: 50% !important;
            left: 50% !important;
            transform: translate(-50%, -50%) !important;
            -webkit-transform: translate(-50%, -50%) !important;
        }

        .watermark img {
            width: 550px !important;
            height: 550px !important;
            opacity: 0.085 !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
    }
</style>

<script type="text/javascript">
    function windowclose() {
        window.close();
    }

    function PrintPanel(copy, name) {
        var isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);

        if (isMobile) {
            var oldTitle = document.title;
            if (name) {
                document.title = name;
            }
            window.print();
            if (name) {
                setTimeout(function () {
                    document.title = oldTitle;
                }, 2000);
            }
            return false;
        }

        // Desktop print
        var divToPrint = document.getElementById(copy);
        if (!divToPrint) {
            window.print();
            return false;
        }

        var newWin = window.open('', '_blank');
        if (!newWin) {
            window.print();
            return false;
        }

        var printCss = '* { box-sizing: border-box !important; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }' +
            '@@page { size: portrait; }' +
            'html, body { font-family: Arial, sans-serif; margin: 0; padding: 0; background: #fff; width: 100%; }' +
            '#prnttb { width: 100% !important; max-width: 100% !important; box-sizing: border-box !important; padding-right: 2px !important; }' +
            '.table { width: 100% !important; border-collapse: collapse !important; margin: 0 !important; }' +
            '.table td, .table th { padding: 2.5px 3px !important; border-top: none; }' +
            '#prnttb table tr th:last-child, #prnttb table tr td:last-child { border-right: 1px solid #000 !important; }' +
            '#prnttb > div > table, #prnttb > table { width: 100% !important; border: 1px solid #000 !important; border-collapse: collapse !important; }' +
            '#prnttb > div > table > tbody > tr > td, #prnttb > div > table > tr > td, #prnttb > table > tbody > tr > td, #prnttb > table > tr > td { border-left: 1px solid #000 !important; border-right: 1px solid #000 !important; }' +
            '.watermark { top: 50% !important; left: 50% !important; transform: translate(-50%, -50%) !important; -webkit-transform: translate(-50%, -50%) !important; }' +
            '.watermark img { width: 550px !important; height: 550px !important; opacity: 0.085 !important; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }';

        newWin.document.open();
        newWin.document.write('<!DOCTYPE html>');
        newWin.document.write('<' + 'html><' + 'head><' + 'title>' + (name || 'Result') + '<' + '/title>');
        newWin.document.write('<' + 'style type="text/css">' + printCss + '<' + '/style>');
        newWin.document.write('<' + '/head><' + 'body>');
        newWin.document.write(divToPrint.outerHTML);
        newWin.document.write('<' + '/body><' + '/html>');
        newWin.document.close();
        newWin.document.title = (name || 'Result');
        newWin.focus();

        setTimeout(function () {
            newWin.print();
            newWin.close();
        }, 400);

        return false;
    }
    window.PrintPanel = PrintPanel;
</script>

<div class="container p-3">
    <div class="row">
        @await Component.InvokeAsync("Result", new { data = Model.EncrptedRoll })
    </div>
</div>
